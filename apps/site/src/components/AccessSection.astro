---
import { CTA_LOGIN_LABEL, CTA_REGISTER_STRONG_LABEL } from '../content/site'
import CtaRow from './CtaRow.astro'
---

<section id="acesso" class="site-anchor py-10 sm:py-16">
  <div class="site-wrap">
    <div class="hero-solid rounded-chrome px-5 py-14 text-inverse sm:px-12 sm:py-16" data-reveal>
      <p class="kicker text-inverse/55">Começar</p>
      <h2 class="section-title mt-4 max-w-xl text-inverse">Cria a clínica. Abre o DRE do mês.</h2>
      <p class="mt-4 max-w-lg text-[16px] leading-7 text-inverse/70">
        Sai da planilha. O cadastro já abre o sistema: lead, agenda e o fechamento no celular.
      </p>
      <CtaRow primary={CTA_REGISTER_STRONG_LABEL} secondary={CTA_LOGIN_LABEL} onDark />
    </div>
  </div>
</section>
