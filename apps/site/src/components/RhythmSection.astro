---
import { RHYTHM_KICKER, RHYTHM_LEAD, RHYTHM_TITLE, rhythmSteps } from '../content/site'
---

<section id="ritmo" class="site-anchor py-20 sm:py-28" aria-labelledby="ritmo-title">
  <div class="site-wrap grid gap-12 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-20">
    <div data-reveal>
      <p class="kicker">{RHYTHM_KICKER}</p>
      <h2 id="ritmo-title" class="section-title mt-4 text-title">
        {RHYTHM_TITLE}
      </h2>
      <p class="mt-5 max-w-md text-[16px] leading-7 text-body">
        {RHYTHM_LEAD}
      </p>
    </div>

    <ol class="m-0 grid list-none gap-0 border-l border-border-divider p-0 pl-6 sm:pl-8" data-reveal-stagger>
      {
        rhythmSteps.map((step) => (
          <li class="relative py-5 first:pt-0 last:pb-0" data-reveal-item>
            <span class="absolute -left-6 top-6 size-2 -translate-x-1/2 rounded-full bg-brand sm:-left-8" />
            <p class="font-mono text-[12px] tabular-nums text-muted">{step.n}</p>
            <h3 class="mt-1 text-[18px] font-semibold tracking-[-0.02em] text-title">{step.title}</h3>
            <p class="mt-1.5 max-w-md text-[15px] leading-6 text-body">{step.copy}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
