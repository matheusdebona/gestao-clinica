---
import { painItems } from '../content/site'
---

<section id="dor" class="site-anchor py-20 sm:py-28" aria-labelledby="dor-title">
  <div class="site-wrap grid gap-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-20">
    <div data-reveal>
      <p class="kicker">Antes do sistema</p>
      <h2 id="dor-title" class="section-title mt-4 text-title">
        Domingo à noite, planilha aberta, ninguém sabe se sobrou.
      </h2>
    </div>

    <ol class="m-0 grid list-none gap-10 border-t border-border-divider p-0 pt-2" data-reveal-stagger>
      {
        painItems.map((item, index) => (
          <li class="grid gap-2 sm:grid-cols-[3rem_1fr] sm:gap-6" data-reveal-item>
            <span class="font-mono text-[13px] tabular-nums text-muted">0{index + 1}</span>
            <div>
              <h3 class="text-[20px] font-semibold tracking-[-0.03em] text-title">{item.title}</h3>
              <p class="mt-2 max-w-md text-[16px] leading-7 text-body">{item.copy}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
