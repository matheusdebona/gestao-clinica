---
import { FEATURES_KICKER, FEATURES_LEAD, FEATURES_TITLE, features } from '../content/site'
---

<section id="produto" class="site-anchor py-20 sm:py-28">
  <div class="site-wrap grid gap-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-20">
    <div data-reveal>
      <p class="kicker">{FEATURES_KICKER}</p>
      <h2 class="section-title mt-4 text-title">{FEATURES_TITLE}</h2>
      <p class="mt-5 max-w-md text-[16px] leading-7 text-body">{FEATURES_LEAD}</p>
    </div>

    <ul class="m-0 grid list-none border-t border-border-divider p-0" data-reveal-stagger>
      {
        features.map((feature) => (
          <li class="border-b border-border-divider" data-reveal-item>
            <a href={feature.href} class="grid gap-1 py-5 sm:grid-cols-[9rem_1fr] sm:gap-8">
              <h3 class="text-[16px] font-semibold tracking-[-0.02em] text-title">{feature.title}</h3>
              <p class="text-[15px] leading-6 text-body">{feature.teaser}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
