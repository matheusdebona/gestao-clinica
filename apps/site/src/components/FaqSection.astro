---
import { faqs } from '../content/site'
---

<section id="faq" class="site-anchor py-16 sm:py-24">
  <div class="site-wrap grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
    <div class="max-w-md" data-reveal>
      <p class="eyebrow glass-chip glass-chip-brand text-brand">Perguntas</p>
      <h2 class="section-title mt-4 text-title">Perguntas diretas.</h2>
      <p class="mt-4 text-[16px] leading-7 text-body">
        Estoque, orçamento, celular e planos. Se a dúvida for outra, crie a clínica e veja o
        produto — o cadastro já abre o sistema.
      </p>
    </div>

    <div class="grid gap-2" data-reveal-stagger>
      {
        faqs.map((item, index) => (
          <details
            class="faq-item overflow-hidden rounded-xl glass-regular"
            open={index === 0}
            data-reveal-item
          >
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-4 py-4 text-[15px] font-semibold tracking-[-0.02em] text-title sm:px-5">
              <h3 class="m-0 text-[15px] font-semibold tracking-[-0.02em]">{item.q}</h3>
            </summary>
            <p class="border-t border-border-divider px-4 pb-4 pt-3 text-[15px] leading-6 text-body sm:px-5">
              {item.a}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>
