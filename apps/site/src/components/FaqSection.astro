---
import { faqs } from '../content/site'
---

<section id="faq" class="site-anchor py-20 sm:py-28">
  <div class="site-wrap grid gap-12 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-20">
    <div data-reveal>
      <p class="kicker">Perguntas</p>
      <h2 class="section-title mt-4 text-title">O que a dona da clínica pergunta.</h2>
    </div>

    <div class="border-t border-border-divider" data-reveal-stagger>
      {
        faqs.map((item) => (
          <details class="faq-item border-b border-border-divider" data-reveal-item>
            <summary class="flex min-h-12 cursor-pointer list-none items-baseline justify-between gap-6 py-5 text-title">
              <h3 class="m-0 text-[17px] font-semibold tracking-[-0.02em]">{item.q}</h3>
              <span class="shrink-0 text-[18px] font-light text-muted" aria-hidden="true">
                +
              </span>
            </summary>
            <p class="pb-5 pr-10 text-[15px] leading-7 text-body">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
