---
const kpis = [
  { label: 'Resultado', value: 'R$ 9.840', tone: 'ok' },
  { label: 'Margem líquida', value: '20%', tone: 'ink' },
]

const lines = [
  { label: 'Receita bruta', value: 'R$ 52.000' },
  { label: 'Taxa da maquininha', value: '− R$ 2.180' },
  { label: 'Impostos sobre a receita', value: '− R$ 1.620' },
  { label: 'Comissões', value: '− R$ 4.160' },
  { label: 'Despesas do mês', value: '− R$ 9.920' },
]
---

<div class="mock-app mock-app-dre">
  <header class="mock-app-head">
    <p class="mock-kicker">Financeiro</p>
    <h3 class="mock-title">DRE do mês</h3>
    <p class="mock-meta">Novembro</p>
  </header>

  <div class="grid grid-cols-2 gap-1.5">
    {
      kpis.map((item) => (
        <div class="mock-card">
          <p class="mock-quiet text-[10px] leading-3">{item.label}</p>
          <p
            class:list={[
              'mt-0.5 text-[15px] font-semibold tabular-nums tracking-[-0.03em]',
              item.tone === 'ok' ? 'mock-ok' : 'mock-ink',
            ]}
          >
            {item.value}
          </p>
        </div>
      ))
    }
  </div>

  <div class="mock-card mock-dre-lines mt-1.5 divide-y divide-border-divider">
    {
      lines.map((row) => (
        <div class="flex items-center justify-between gap-2 py-[5px] first:pt-0 last:pb-0">
          <span class="mock-copy text-[11px] leading-4">{row.label}</span>
          <span class="mock-quiet shrink-0 text-[11px] tabular-nums">{row.value}</span>
        </div>
      ))
    }
  </div>

  <div class="mock-card mock-dre-net mt-1.5">
    <div class="flex items-end justify-between gap-2">
      <div>
        <p class="mock-quiet text-[10px] leading-3">Resultado líquido</p>
        <p class="mock-ok mt-0.5 text-[18px] font-semibold tabular-nums tracking-[-0.03em]">R$ 9.840</p>
      </div>
      <p class="mock-ink text-right text-[11px] font-semibold tabular-nums">20%</p>
    </div>
  </div>
</div>
