---
import {
  CTA_FREE_NOTE,
  CTA_LOGIN_LABEL,
  CTA_REGISTER_STRONG_LABEL,
  HERO_KICKER,
  HERO_LEAD,
  HERO_STAGE_CAPTION,
  HERO_TITLE_EMPHASIS,
  HERO_TITLE_LEAD,
} from '../content/site'
import { APP_LOGIN_URL, APP_REGISTER_URL } from '../lib/urls'
import BrandMark from './BrandMark.astro'
import MockDre from './mocks/MockDre.astro'
import MockSpreadsheet from './mocks/MockSpreadsheet.astro'
import PhoneFrame from './PhoneFrame.astro'
---

<section id="topo" class="hero-solid relative overflow-hidden">
  <div class="hero-grid site-wrap relative grid lg:grid-cols-[minmax(0,1fr)_minmax(20rem,28rem)] lg:items-end">
    <div class="hero-copy max-w-xl text-inverse">
      <BrandMark class="hero-logo w-auto text-brand" decorative={false} />
      <p class="hero-kicker kicker text-inverse/55">{HERO_KICKER}</p>
      <h1 class="hero-title display-title text-inverse">
        {HERO_TITLE_LEAD}
        <span class="mt-2 block font-normal text-inverse/80">{HERO_TITLE_EMPHASIS}</span>
      </h1>
      <p class="hero-lead max-w-[34rem] text-[17px] leading-7 text-inverse/72">
        {HERO_LEAD}
      </p>
      <div class="hero-ctas grid w-full grid-cols-1 gap-3 sm:max-w-sm">
        <a
          class="site-cta-primary w-full"
          href={APP_REGISTER_URL}
          data-section-cta
        >
          {CTA_REGISTER_STRONG_LABEL}
        </a>
        <a
          class="site-cta-secondary site-cta-on-dark w-full"
          href={APP_LOGIN_URL}
        >
          {CTA_LOGIN_LABEL}
        </a>
        <p class="text-center text-[13px] leading-5 text-inverse/50">{CTA_FREE_NOTE}</p>
      </div>
    </div>

    <div class="hero-stage relative mx-auto w-full max-w-[28rem] lg:mx-0 lg:justify-self-end" data-hero-stage>
      <div class="hero-swap">
        <div class="hero-sheet">
          <MockSpreadsheet />
        </div>
        <div class="hero-phone">
          <PhoneFrame label="DRE do mês, tela de exemplo">
            <MockDre />
          </PhoneFrame>
        </div>
      </div>
      <p class="hero-stage-caption text-[13px] leading-5 text-inverse/50">
        {HERO_STAGE_CAPTION}
      </p>
    </div>
  </div>

  <a class="hero-scroll-cue" href="#dor" aria-label="Rolar para a próxima seção">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m6 9 6 6 6-6" />
    </svg>
  </a>
</section>
<div class="hero-after hero-solid-band" data-hero-after></div>

<script>
  // Mobile: the hero is exactly one screen (100svh). Scale the mock to the space left under the
  // copy. If it would be too small to read, move it right below the hero instead of clipping it.
  const MIN_ZOOM = 0.4
  const hero = document.getElementById('topo')
  const after = document.querySelector<HTMLElement>('[data-hero-after]')
  const grid = hero?.querySelector<HTMLElement>('.hero-grid')
  const copy = hero?.querySelector<HTMLElement>('.hero-copy')
  const stage = hero?.querySelector<HTMLElement>('.hero-stage')
  const swap = stage?.querySelector<HTMLElement>('.hero-swap')
  const caption = stage?.querySelector<HTMLElement>('.hero-stage-caption')
  const mobile = window.matchMedia('(max-width: 1023.98px)')
  let lastKey = ''

  function fitHeroStage(force = false) {
    if (!hero || !after || !grid || !copy || !stage || !swap || !caption) return
    const screen = parseFloat(getComputedStyle(hero).minHeight) || window.innerHeight
    // iOS fires resize while the toolbar collapses on scroll; svh does not change then, so skip.
    const key = `${window.innerWidth}x${screen}x${copy.offsetHeight}`
    if (!force && key === lastKey) return
    lastKey = key

    if (stage.parentElement !== grid) grid.append(stage)
    hero.classList.remove('hero-copy-only')
    swap.style.removeProperty('--hero-stage-zoom')
    if (!mobile.matches) return

    const g = getComputedStyle(grid)
    const other =
      parseFloat(g.paddingTop) +
      parseFloat(g.paddingBottom) +
      parseFloat(g.rowGap) +
      copy.offsetHeight +
      caption.offsetHeight +
      parseFloat(getComputedStyle(caption).marginTop)
    const natural = parseFloat(getComputedStyle(swap).minHeight) || 572
    const zoom = Math.min(1, Math.floor(((screen - other - 1) / natural) * 100) / 100)
    if (zoom >= MIN_ZOOM) swap.style.setProperty('--hero-stage-zoom', String(zoom))
    else {
      hero.classList.add('hero-copy-only')
      after.append(stage)
    }
  }

  fitHeroStage(true)
  window.addEventListener('resize', () => fitHeroStage(), { passive: true })
  mobile.addEventListener('change', () => fitHeroStage(true))
  if (copy && 'ResizeObserver' in window) new ResizeObserver(() => fitHeroStage()).observe(copy)
  document.fonts?.ready.then(() => fitHeroStage(true))
</script>
