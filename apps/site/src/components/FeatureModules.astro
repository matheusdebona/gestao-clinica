---
import { features } from '../content/site'
import AppMock from './AppMock.astro'
import CtaRow from './CtaRow.astro'
import ModuleIcon from './ModuleIcon.astro'

const mocks: Record<(typeof features)[number]['id'], { caption: string }> = {
  estoque: { caption: 'Estoque · lotes' },
  protocolos: { caption: 'Protocolo · preços' },
  pacientes: { caption: 'Paciente · histórico' },
  agenda: { caption: 'Agenda · hoje' },
  metricas: { caption: 'Números · período' },
}
---

{
  features.map((feature, index) => (
    <section
      id={feature.id}
      class="site-anchor py-12 sm:py-16"
      aria-labelledby={`${feature.id}-title`}
    >
      <div class="site-wrap grid items-center gap-8 lg:grid-cols-2 lg:gap-14">
        <div class:list={[index % 2 === 1 && 'lg:order-2']} data-reveal>
          <p class="eyebrow glass-chip glass-chip-brand gap-1.5 text-brand">
            <ModuleIcon name={feature.id} class="size-3.5" />
            {feature.title}
          </p>
          <h2
            id={`${feature.id}-title`}
            class="section-title mt-4 text-title"
          >
            {feature.headline}
          </h2>
          <p class="mt-4 max-w-xl text-[16px] leading-7 text-body">{feature.copy}</p>
          <ul class="mt-5 grid list-none gap-2.5 p-0">
            {feature.points.map((point) => (
              <li class="flex gap-2.5 text-[15px] leading-6 text-body">
                <span
                  class="mt-2 size-1.5 shrink-0 rounded-full bg-brand"
                  aria-hidden="true"
                />
                {point}
              </li>
            ))}
          </ul>
          <CtaRow />
        </div>

        <div class:list={[index % 2 === 1 && 'lg:order-1']} data-reveal>
          <AppMock caption={mocks[feature.id].caption}>
            {feature.id === 'estoque' && (
              <div class="grid gap-2">
                <div class="flex items-center justify-between rounded-[10px] bg-surface-muted px-3 py-2.5">
                  <div>
                    <p class="text-[14px] font-medium text-title">Toxina</p>
                    <p class="text-[12px] text-muted">Lote A14 · val. 11/2026</p>
                  </div>
                  <span class="text-[12px] font-medium text-brand">no prazo</span>
                </div>
                <div class="flex items-center justify-between rounded-[10px] bg-surface-muted px-3 py-2.5">
                  <div>
                    <p class="text-[14px] font-medium text-title">Ácido hialurônico</p>
                    <p class="text-[12px] text-muted">Lote B02 · val. 03/2027</p>
                  </div>
                  <span class="text-[12px] font-medium text-brand">no prazo</span>
                </div>
                <p class="px-1 pt-1 text-[12px] leading-5 text-muted">
                  Baixa na sessão — o frasco ainda não saiu na venda.
                </p>
              </div>
            )}

            {feature.id === 'protocolos' && (
              <div class="grid gap-3">
                <div>
                  <p class="text-[12px] font-medium uppercase tracking-[0.06em] text-muted">
                    Harmonização facial
                  </p>
                  <p class="mt-1 text-[15px] font-semibold text-title">4 sessões · composição</p>
                </div>
                <dl class="grid grid-cols-2 gap-2">
                  {[
                    ['Custo', 'interno'],
                    ['Sugerido', 'tabela'],
                    ['Mínimo', 'piso'],
                    ['Especial', 'acordo'],
                  ].map(([label, hint]) => (
                    <div class="rounded-[10px] bg-surface-muted px-3 py-2.5">
                      <dt class="text-[12px] text-muted">{label}</dt>
                      <dd class="text-[14px] font-medium text-title">{hint}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            )}

            {feature.id === 'pacientes' && (
              <div class="grid gap-2">
                <div class="rounded-[10px] bg-surface-muted px-3 py-3">
                  <p class="text-[15px] font-semibold text-title">Paciente em acompanhamento</p>
                  <p class="mt-1 text-[13px] text-muted">Origem: indicação · WhatsApp no cadastro</p>
                </div>
                <div class="flex items-center justify-between rounded-[10px] bg-surface-muted px-3 py-2.5">
                  <span class="text-[14px] text-title">Orçamento aceito</span>
                  <span class="text-[12px] text-muted">venda</span>
                </div>
                <div class="flex items-center justify-between rounded-[10px] bg-surface-muted px-3 py-2.5">
                  <span class="text-[14px] text-title">Sessão 2 de 4</span>
                  <span class="text-[12px] text-muted">tratamento</span>
                </div>
              </div>
            )}

            {feature.id === 'agenda' && (
              <ul class="grid list-none gap-2 p-0">
                {[
                  ['09:00', 'Avaliação'],
                  ['14:00', 'Harmonização · sessão 2'],
                  ['16:30', 'Retorno'],
                ].map(([time, label]) => (
                  <li class="flex items-center justify-between rounded-[10px] bg-surface-muted px-3 py-2.5">
                    <span class="text-[14px] text-title">{label}</span>
                    <span class="text-[12px] tabular-nums text-muted">{time}</span>
                  </li>
                ))}
              </ul>
            )}

            {feature.id === 'metricas' && (
              <div class="grid gap-2 sm:grid-cols-3">
                <div class="rounded-[10px] bg-surface-muted px-3 py-3">
                  <p class="text-[12px] text-muted">Margem</p>
                  <p class="mt-1 text-[16px] font-semibold tracking-[-0.03em] text-title">
                    após a sessão
                  </p>
                </div>
                <div class="rounded-[10px] bg-surface-muted px-3 py-3">
                  <p class="text-[12px] text-muted">Comercial</p>
                  <p class="mt-1 text-[16px] font-semibold tracking-[-0.03em] text-title">
                    orçamento → venda
                  </p>
                </div>
                <div class="rounded-[10px] bg-surface-muted px-3 py-3 sm:col-span-1">
                  <p class="text-[12px] text-muted">Operação</p>
                  <p class="mt-1 text-[16px] font-semibold tracking-[-0.03em] text-title">
                    estoque no tratamento
                  </p>
                </div>
              </div>
            )}
          </AppMock>
        </div>
      </div>
    </section>
  ))
}
