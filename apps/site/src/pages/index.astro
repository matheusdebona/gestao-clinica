---
import AccessSection from '../components/AccessSection.astro'
import ClinicsSection from '../components/ClinicsSection.astro'
import FaqSection from '../components/FaqSection.astro'
import FeatureBento from '../components/FeatureBento.astro'
import HeroMotion from '../components/HeroMotion.vue'
import HeroSection from '../components/HeroSection.astro'
import MobileHandSection from '../components/MobileHandSection.astro'
import PainSection from '../components/PainSection.astro'
import ProductShowcase from '../components/ProductShowcase.astro'
import RhythmSection from '../components/RhythmSection.astro'
import ScrollReveal from '../components/ScrollReveal.vue'
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.vue'
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout>
  <SiteHeader client:load />
  <main>
    <HeroMotion client:load>
      <HeroSection />
    </HeroMotion>
    <ScrollReveal client:visible>
      <PainSection />
      <ProductShowcase />
      <FeatureBento />
      <RhythmSection />
      <MobileHandSection />
      <ClinicsSection />
      <FaqSection />
      <AccessSection />
    </ScrollReveal>
  </main>
  <SiteFooter />
</BaseLayout>
