APP_NAME="Gestao Clinica"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_PORT=8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=gestao_clinica
DB_USERNAME=gestao
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
PERMISSION_CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minioSecret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=gestao-clinica
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=http://localhost:9000/gestao-clinica

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Chromium path for Spatie Browsershot (set in Docker image)
BROWSERSHOT_CHROME_PATH=/usr/bin/chromium
# BROWSERSHOT_NODE_BINARY=
# BROWSERSHOT_NPM_BINARY=
# BROWSERSHOT_TIMEOUT=60

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1

DEMO_CLINIC_NAME="Clínica Demo"
DEMO_CLINIC_EMAIL=contato@clinica-demo.test
DEMO_ADMIN_NAME="Admin Clínica"
DEMO_ADMIN_EMAIL=admin@clinica-demo.test
DEMO_ADMIN_PASSWORD="ChangeMe!123"

# Optional platform super-admin (no clinic)
# SUPER_ADMIN_NAME="Super Admin"
# SUPER_ADMIN_EMAIL=super@gestao-clinica.test
# SUPER_ADMIN_PASSWORD="ChangeMe!123"

VITE_APP_NAME="${APP_NAME}"
